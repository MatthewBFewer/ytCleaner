
{
  "manifest_version": 3,
  "name": "ytCleaner",
  "version": "1.1",
  "description": "Removes garbage from various areas of YouTube, i.e. recommended videos, comments, some ads, shorts",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/",
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/results*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
